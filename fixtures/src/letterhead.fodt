<?xml version="1.0" encoding="UTF-8"?>
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
<office:body><office:text>

<text:p>Both delimiter styles: {{customer}} and {reference}.</text:p>

<text:p>
  <draw:frame draw:name="Box1" text:anchor-type="as-char" svg:width="7cm" svg:height="2cm" draw:z-index="0">
    <draw:text-box><text:p>Registered office: {registered_office}</text:p></draw:text-box>
  </draw:frame>
</text:p>

<text:p>Contact <text:a xlink:href="https://example.com/">{contact} on {phone}</text:a> for questions.</text:p>

<text:list>
  <text:list-item><text:p>{#bullets}{.}{/bullets}</text:p></text:list-item>
</text:list>

<text:p>Signed, {{signatory}}.</text:p>

</office:text></office:body></office:document>
