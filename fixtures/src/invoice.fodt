<?xml version="1.0" encoding="UTF-8"?>
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">

<office:automatic-styles>
  <style:style style:name="Bold" style:family="text">
    <style:text-properties fo:font-weight="bold"/>
  </style:style>
  <style:page-layout style:name="pm1">
    <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
      fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>
    <style:header-style>
      <style:header-footer-properties fo:min-height="1cm" fo:margin-bottom="0.5cm"/>
    </style:header-style>
    <style:footer-style>
      <style:header-footer-properties fo:min-height="1cm" fo:margin-top="0.5cm"/>
    </style:footer-style>
  </style:page-layout>
</office:automatic-styles>

<office:master-styles>
  <style:master-page style:name="Standard" style:page-layout-name="pm1">
    <style:header><text:p>Invoice {invoice_no} for {customer.name}</text:p></style:header>
    <style:footer><text:p>{invoice_no} - {company}</text:p></style:footer>
  </style:master-page>
</office:master-styles>

<office:body><office:text>

<text:p>{%logo}</text:p>
<text:h text:outline-level="1">Invoice <text:span text:style-name="Bold">{invoice_no}</text:span></text:h>
<text:p>Date: {issued|date:DD MMMM YYYY}</text:p>
<text:p>Bill to:</text:p>
<text:p>{customer.name}</text:p>
<text:p>{customer.address}</text:p>

<table:table table:name="Items">
  <table:table-column table:number-columns-repeated="4"/>
  <table:table-row>
    <table:table-cell office:value-type="string"><text:p><text:span text:style-name="Bold">Description</text:span></text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p><text:span text:style-name="Bold">Qty</text:span></text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p><text:span text:style-name="Bold">Unit price</text:span></text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p><text:span text:style-name="Bold">Line total</text:span></text:p></table:table-cell>
  </table:table-row>
  <table:table-row>
    <table:table-cell office:value-type="string"><text:p>{#items}{description}</text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p>{qty}</text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p>{unit_price|currency:EUR}</text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p>{line_total|currency:EUR}{/items}</text:p></table:table-cell>
  </table:table-row>
  <table:table-row>
    <table:table-cell office:value-type="string"><text:p/></table:table-cell>
    <table:table-cell office:value-type="string"><text:p/></table:table-cell>
    <table:table-cell office:value-type="string"><text:p><text:span text:style-name="Bold">Total due</text:span></text:p></table:table-cell>
    <table:table-cell office:value-type="string"><text:p><text:span text:style-name="Bold">{items|sumProduct:qty:unit_price|currency:EUR}</text:span></text:p></table:table-cell>
  </table:table-row>
</table:table>

<text:p>{^paid}Please pay within {terms_days} days.{/paid}{#paid}Paid in full - thank you.{/paid}</text:p>

<text:p>Notes</text:p>
<text:p>{#notes}</text:p>
<text:p>- {.}</text:p>
<text:p>{/notes}</text:p>

<text:p>{company} - {items|count} line items on this invoice.</text:p>

</office:text></office:body></office:document>
