{
  "name": "docmint-api",
  "version": "0.1.0",
  "private": true,
  "description": "DocMint - fill DOCX/XLSX/PPTX templates with JSON data, get the file or a PDF back",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "stripe": "^17.6.0"
  }
}
