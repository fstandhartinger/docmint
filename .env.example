# Copy to .env.local. Only the first two are needed to start.

# Postgres. Any Postgres will do; production runs on a Neon free-tier database.
DATABASE_URL=postgresql://user:password@localhost:5432/docmint

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# The URL this deployment is reachable at. Canonical tags, hosted-file links and
# Stripe redirects are built from it, and a GET arriving on any other hostname is
# 301'd here. Leave it empty locally.
PUBLIC_URL=
PORT=3000

# Set to production on a real deployment: it is what decides whether this process
# writes 'production' or 'dev' into the usage log. DOCMINT_ORIGIN overrides it.
NODE_ENV=

# Billing. Without these the billing routes are inert and every account stays free.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# LibreOffice, for "output":"pdf". Without it everything else still works and
# GET /v1/capabilities reports pdf.available = false.
# SOFFICE_BIN=/usr/bin/soffice
# One conversion peaks at 219 MB, measured. That is what fits beside Node in a
# 512 MB container.
MAX_CONCURRENT_PDF=1

# Runs the asynchronous job worker in this process. One instance should have it.
JOBS_WORKER=1

# Lets a local test point a webhook at 127.0.0.1. Never set this in production:
# with it on, a caller-supplied URL becomes a server-side request forgery primitive.
# ALLOW_PRIVATE_NETWORK=
